# ==========================================
# TELEGRAM
# ==========================================

# Новий токен після перевипуску в @BotFather
BOT_TOKEN=8962594489:AAEeihkLupxbJB6ZOIonzaL-Cb7hlzRd5HE

# Username без @
BOT_USERNAME=soskaopen_bot

# ROOT ADMIN
ROOT_ADMIN_IDS=5480082089


# ==========================================
# TELEGRAM REPORT GROUP
# ==========================================

# Основна група звітів
REPORT_GROUP_CHAT_ID=-1004414717666

# Вінниця
REPORT_TOPIC_VINNYTSIA=6

# Хмельницький — перша частина
REPORT_TOPIC_KHMELNYTSKYI_1=2

# Хмельницький — друга частина
REPORT_TOPIC_KHMELNYTSKYI_2=4

# Загальна гілка каси всієї мережі
NETWORK_CASH_TOPIC_ID=1


# ==========================================
# CLOSING REPORTS
# ==========================================

# Та сама Telegram-група
CLOSING_GROUP_ID=-1004414717666

# Не задаємо один topic,
# бо використовуємо окремі Topics по регіонах
CLOSING_GROUP_TOPIC_ID=


# ==========================================
# DATABASE — RAILWAY POSTGRES
# ==========================================

# Якщо сервіс бази в Railway називається Postgres
DATABASE_URL=${{Postgres.DATABASE_URL}}

# config.py сформує sync URL автоматично
DATABASE_SYNC_URL=

DATABASE_ECHO=false

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30


# ==========================================
# APPLICATION
# ==========================================

APP_NAME=TT-open

APP_ENV=production

TIMEZONE=Europe/Kyiv

LOG_LEVEL=INFO
LOG_FORMAT=console

DEBUG=false


# ==========================================
# BOT MODE
# ==========================================

# Поки працюємо через polling
USE_WEBHOOK=false

APP_BASE_URL=
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=

WEB_SERVER_HOST=0.0.0.0

# Railway сам передає PORT.
# WEB_SERVER_PORT можна не задавати.


# ==========================================
# REGISTRATION AND ACCESS
# ==========================================

REQUIRE_STORE_APPROVAL=true

ALLOW_MULTIPLE_STORE_USERS=true

DEFAULT_INVITE_EXPIRATION_HOURS=24

DEFAULT_INVITE_MAX_USES=1


# ==========================================
# OPENING CHECK-IN
# ==========================================

ENABLE_OPENING_REMINDERS=true

OPENING_REMINDER_BEFORE_MINUTES=10

OPENING_LATE_REMINDER_MINUTES=5

DEFAULT_OPENING_DEADLINE_MINUTES=10

SCHEDULER_CHECK_INTERVAL_SECONDS=60


# ==========================================
# CLOSING REPORTS
# ==========================================

ENABLE_CLOSING_REMINDERS=true

CLOSING_REMINDER_BEFORE_MINUTES=10

DEFAULT_CLOSING_DEADLINE_MINUTES=15

MAX_CASH_AMOUNT=100000000

REQUIRE_RECEIPT_PHOTO=true


# ==========================================
# REPORTS
# ==========================================

REPORTS_DIRECTORY=storage/reports

REPORT_FILE_LIFETIME_HOURS=24

NETWORK_NAME=Soska Bar


# ==========================================
# SECURITY
# ==========================================

SECRET_KEY=ВСТАВ_НОВИЙ_SECRET_KEY

INVITE_TOKEN_SALT=ВСТАВ_НОВИЙ_INVITE_TOKEN_SALT

RATE_LIMIT_REQUESTS_PER_MINUTE=60


# ==========================================
# SCHEDULER LOCK
# ==========================================

ENABLE_SCHEDULER_LOCK=true

SCHEDULER_LOCK_ID=27182818