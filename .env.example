# ==========================================
# TELEGRAM
# ==========================================

# Токен Telegram-бота від @BotFather
# Перед реальним запуском заміни на справжній токен
BOT_TOKEN=8962594489:AAEeihkLupxbJB6ZOIonzaL-Cb7hlzRd5HE

# Username бота без символу @
BOT_USERNAME=soskaopen_bot

# Telegram ID головних адміністраторів через кому
ROOT_ADMIN_IDS=5480082089

# Telegram-група для вечірніх звітів
# Заповнимо після створення групи
CLOSING_GROUP_ID=

# ID теми у групі, якщо використовуватимемо Topics
CLOSING_GROUP_TOPIC_ID=


# ==========================================
# DATABASE
# ==========================================

# Асинхронне підключення до PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chikin_bot

# Синхронне підключення для Alembic
DATABASE_SYNC_URL=postgresql+psycopg://postgres:postgres@localhost:5432/chikin_bot

# Виводити SQL-запити в консоль
DATABASE_ECHO=false

# Основний розмір пулу з’єднань
DATABASE_POOL_SIZE=10

# Додаткові з’єднання понад основний пул
DATABASE_MAX_OVERFLOW=20

# Максимальний час очікування з’єднання
DATABASE_POOL_TIMEOUT=30


# ==========================================
# APPLICATION
# ==========================================

APP_NAME=TT-open

# development, testing або production
APP_ENV=development

TIMEZONE=Europe/Kyiv

LOG_LEVEL=INFO

# console або json
LOG_FORMAT=console

DEBUG=true


# ==========================================
# BOT MODE
# ==========================================

# Для локальної розробки використовуємо polling
USE_WEBHOOK=false

# Заповнимо після розміщення на Railway
APP_BASE_URL=

WEBHOOK_URL=

WEBHOOK_PATH=/webhook

WEBHOOK_SECRET=

WEB_SERVER_HOST=0.0.0.0

WEB_SERVER_PORT=8080


# ==========================================
# REGISTRATION AND ACCESS
# ==========================================

# Прив’язку користувача до ТТ підтверджує адміністратор
REQUIRE_STORE_APPROVAL=true

# До однієї ТТ можна прив’язати декількох працівників
ALLOW_MULTIPLE_STORE_USERS=true

# Термін дії стандартного запрошення
DEFAULT_INVITE_EXPIRATION_HOURS=24

# Кількість використань стандартного запрошення
DEFAULT_INVITE_MAX_USES=1


# ==========================================
# OPENING CHECK-IN
# ==========================================

ENABLE_OPENING_REMINDERS=true

# Нагадування за 10 хвилин до відкриття
OPENING_REMINDER_BEFORE_MINUTES=10

# Повторне нагадування через 5 хвилин після відкриття
OPENING_LATE_REMINDER_MINUTES=5

# Контрольний дедлайн через 10 хвилин
DEFAULT_OPENING_DEADLINE_MINUTES=10

# Перевірка статусів щохвилини
SCHEDULER_CHECK_INTERVAL_SECONDS=60


# ==========================================
# CLOSING REPORTS
# ==========================================

ENABLE_CLOSING_REMINDERS=true

# Нагадування за 10 хвилин до закриття
CLOSING_REMINDER_BEFORE_MINUTES=10

# Дедлайн подання вечірнього звіту
DEFAULT_CLOSING_DEADLINE_MINUTES=15

# Максимально допустима каса
MAX_CASH_AMOUNT=10000000

# Фото чека обов’язкове
REQUIRE_RECEIPT_PHOTO=true


# ==========================================
# REPORTS
# ==========================================

REPORTS_DIRECTORY=storage/reports

REPORT_FILE_LIFETIME_HOURS=24

NETWORK_NAME=Soska Bar


# ==========================================
# SECURITY
# ==========================================

SECRET_KEY=qIQGh4gGMCk0P2p12lJUn2TvS827ZkxbfgrFjz2M6QIcnCzcN_xkttII_Xit7FYH

INVITE_TOKEN_SALT=Kg7xNv9Fm2Qa5Rt8Lc3Wp6Hy1Zd4Bs0Uj9Ee7Mi2Vq5Af8Pn

RATE_LIMIT_REQUESTS_PER_MINUTE=60


# ==========================================
# SCHEDULER LOCK
# ==========================================

ENABLE_SCHEDULER_LOCK=true

SCHEDULER_LOCK_ID=27182818